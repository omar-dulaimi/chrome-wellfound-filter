{
  "manifest_version": 3,
  "name": "Wellfound India Filter",
  "version": "1.0",
  "description": "Hides India-based or INR-compensated job listings on Wellfound.",
  "host_permissions": ["https://wellfound.com/*"],
  "content_scripts": [
    {
      "matches": ["https://wellfound.com/jobs*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
